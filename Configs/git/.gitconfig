[user]
name = Francesco Lucarelli
email = 67560467+fraluc06@users.noreply.github.com
signingkey = ~/.ssh/id_ed25519.pub
autocrlf = input
[credential "https://github.com"]
helper =
helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
helper =
helper = !/opt/homebrew/bin/gh auth git-credential
[init]
defaultBranch = main
[gpg]
format = ssh
[commit]
gpgsign = true
[gpg "ssh"]
	program = ~/.ssh/git-ssh-sign-wrapper
	allowedSignersFile = /Users/francesco/.ssh/allowed_signers
[core]
	autocrlf = input
